{
  "name": "clone-tabnews.com.br",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run services:up && bun run wait-for-postgres && bun run migrations:up && bun --bun next dev",
    "build": "bun --bun next build",
    "start": "next start",
    "lint": "eslint",
    "services:up": "docker compose -f infra/compose.yml up -d",
    "services:down": "docker compose -f infra/compose.yml down",
    "services:stop": "docker compose -f infra/compose.yml stop",
    "test": "bun run services:up && bun run wait-for-postgres && bun run migrations:up && concurrently --names next,test --hide next -k -s command-test \"bun --bun next dev\" \"bun test --timeout 30000 --verbose\"",
    "test:watch": "bun test --watch",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "bun run --bun node-pg-migrate --migrations-dir infra/migrations up",
    "migrations:down": "bun run --bun node-pg-migrate --migrations-dir infra/migrations down",
    "wait-for-postgres": "bun run infra/scripts/wait-for-postgres.ts"
  },
  "dependencies": {
    "@types/pg": "^8.16.0",
    "config": "^4.3.0",
    "dotenv": "^17.3.1",
    "dotenv-expand": "^12.0.3",
    "next": "16.1.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/async-retry": "^1.4.9",
    "@types/bun": "^1.3.9",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "async-retry": "^1.3.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}