{
  "name": "clone-tabnews.com.br",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run services:up && bun --bun next dev",
    "build": "bun --bun next build",
    "start": "next start",
    "lint": "eslint",
    "services:up": "docker compose -f infra/compose.yml up -d",
    "services:down": "docker compose -f infra/compose.yml down",
    "services:stop": "docker compose -f infra/compose.yml stop",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations up",
    "migrations:down": "node-pg-migrate --migrations-dir infra/migrations down"
  },
  "dependencies": {
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "next": "16.0.1",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "^1.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}